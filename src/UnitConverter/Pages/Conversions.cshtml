@page "/Conversions/{conversionType=MilesToKilometers}/{input=3.1415}"
@using Microsoft.AspNetCore.Mvc.RazorPages
@using Microsoft.VisualBasic
@model UnitConverter.ConversionsModel;

@{
}

<div>

<!--Adds header -->
<h1>@ViewData["ConversionType"]</h1>

<!--Adds an error message to replace the header if something goes wrong-->
        <p class="text-danger">@ViewData["ErrorMessage"]</p>

        <h5><br/>Input: @Model.Conversion.Input @Model.InputType</h5>
        <h5>Output: @Model.Conversion.Output @Model.OutputType (rounded)</h5>

        <!--Adds the input value form the cs class and the output value
        from cs class to be displayed on webpage. -->

        <br/><a href="/Index">Return to Conversion form.</a>


</div>
