@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
</div>

<div class="conversionForm">
    <form method="get" asp-page="/Conversions">

        <!--Adds a form for conversionType. Users can select a type and submit with a button.
        -->
        <label for="Conversion.ConversionType">Conversion Type</label>
        <select id="Conversion.ConversionType"
                type="text"
                class="form-select"
                name="Conversion.ConversionType">
            @foreach (var conversion in ConversionTypes.All)
            {
                <option value="@conversion.Key">@conversion.Value</option>
            }
        </select>
        <br/>

        <!--Adds a form for a conversion input. Users can enter a number and submit with a button.
        It will take then take them to the Conversion page.-->
        <label for="Conversion.Input">Conversion Input</label>
        <input id="Conversion.Input"
               class="form-control"
               name="Conversion.Input"
               type="text"
        />

        <button class="btn btn-primary">Submit</button>
    </form>

    <br/><hr/>
    <a asp-page="/QuickConversions">Go to Quick Conversions</a>
</div>
