@page
@model UnitConverter.Pages.Logs

@{
    ViewData["Title"] = "Logs";
}

<div>
    <!--Lets up a select list for the different log levels -->
    <form>
        <label asp-for="Level" class="form-label">Level</label>
        <select asp-for="Level" class="form-select">
            <option value="">All</option>
            <option value="Information">Information</option>
            <option value="Warning">Warning</option>
            <option value="Error">Error</option>
        </select>

        <!--Lets up a select list for the different conversion types -->
        <label asp-for="ConversionType" class="form-label">Conversion Type</label>
        <select asp-for="ConversionType"
                type="text"
                class="form-select"
                name="ConversionType">
            <option value="">All</option>
            @foreach (var conversion in ConversionTypes.All)
            {
                <option value="@conversion.Key">@conversion.Value</option>
            }
        </select>
        <!--Sets up a button to submit after choosing an option(s) from the select lists -->
        <button class="btn btn-primary" type="submit">Search</button>
    </form>
    <br/>
    <!--Lets up a button to clear the log list to nothing-->
    <form method="post" asp-page-handler="ClearList">
        <button class="btn btn-primary" type="submit">Clear</button>
    </form>
</div>
<br/><hr/>
<!--Lets up a table to show the logs and its time, level, message, conversion, input, and result. -->
<div class="table-responsive">
    <table class="table table-striped">
        <thead class= "table-dark">
        <tr>
            <th scope="col">Timestamp</th>
            <th scope="col">Level</th>
            <th scope="col">Message</th>
            <th scope="col">Conversion</th>
            <th scope="col">Input</th>
            <th scope="col">Result</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var entry in Model.Entries)
        {
            <tr>
                <td>@entry.Timestamp</td>
                <td>@entry.Level</td>
                <td>@entry.Message</td>
                <td>@entry.ConversionType</td>
                <td>@entry.Input</td>
                <td>@entry.Result</td>
            </tr>
        }
        </tbody>
    </table>

    <!--A message for if there is nothing the table shows -->
    <h5>@ViewData["IfNone"]</h5>
</div>
